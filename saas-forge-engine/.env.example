# ── SaaS-Forge Engine ─────────────────────────────────────────────
# Porta do painel do orquestrador (isolada das portas dos projetos gerados)
FORGE_PORT=4600

# ── Provedor de LLM ───────────────────────────────────────────────
# Valores: anthropic | local | mock
# - anthropic : usa a API da Anthropic (requer ANTHROPIC_API_KEY)
# - local     : usa um endpoint compatível com OpenAI (Ollama, LM Studio…)
# - mock      : gera código a partir de templates determinísticos (sem rede)
# Se omitido: usa "anthropic" quando ANTHROPIC_API_KEY existir,
# senão "local" quando FORGE_LLM_BASE_URL existir, senão "mock".
FORGE_LLM_PROVIDER=

# Anthropic (nuvem)
ANTHROPIC_API_KEY=
FORGE_LLM_MODEL=claude-sonnet-5

# LLM local (endpoint compatível com OpenAI /v1/chat/completions)
FORGE_LLM_BASE_URL=http://localhost:11434
FORGE_LLM_LOCAL_MODEL=qwen2.5-coder:14b

# ── Pipeline ──────────────────────────────────────────────────────
# Tentativas por etapa antes de abortar a esteira
FORGE_STEP_RETRIES=2
# Roda "npm install" automaticamente no projeto gerado (true/false)
FORGE_AUTO_INSTALL=true
